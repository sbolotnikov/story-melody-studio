{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "timestamp"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Completed questionnaires turned into orders",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "projectType": {
          "type": "string"
        },
        "occasion": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "timestamp"
        }
      },
      "required": ["userId", "projectType", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Store package/product information editable by admins",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "timestamp"
        }
      },
      "required": ["title", "price", "description", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Collection of user profiles."
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Collection of user generated orders from questionnaires."
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Collection of editable products."
    }
  }
}
